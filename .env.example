# Contact form (Gmail SMTP via Nodemailer) — required for /api/contact
# 1. On the Google account you want to send from, enable 2-Step Verification.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (pick "Mail" / "Other") — it's a 16-character code.
# 3. Set the values below. Keep them server-side (do NOT prefix with NEXT_PUBLIC_).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Optional: where contact notifications are delivered. Defaults to GMAIL_USER.
# e.g. CONTACT_TO_EMAIL=rohans9@uci.edu
CONTACT_TO_EMAIL=
