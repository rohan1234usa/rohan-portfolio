# Contact form (Resend) — required for /api/contact
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override the From address. Defaults to Resend's onboarding sender.
# Once you've verified your own domain in Resend, set this to e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
